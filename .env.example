# Copy this file to .env and fill in real values. Do not commit .env.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shopflow

# ---- pgAdmin (only with the "tools" compose profile) ----
PGADMIN_EMAIL=CHANGE_ME@example.com
PGADMIN_PASSWORD=CHANGE_ME

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:5000

# Note: the .NET backend reads its connection string and JWT settings
# from `dotnet user-secrets` in development, not from this file.
